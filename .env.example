# copy to .env or export in your shell
OLLAMA_API_BASE=http://localhost:11434
HELPDESK_MODEL=helpdesk-qwen3:8b          # or helpdesk-llama3.1:8b (created by scripts/setup_ollama.sh)
HELPDESK_EMBED_MODEL=nomic-embed-text
HELPDESK_TEMPERATURE=0.2
HELPDESK_MIN_SIMILARITY=0.50              # below this best cosine score, retrieval reports "nothing relevant"
HELPDESK_USE_BM25=1                       # 0 = dense-only retrieval (for the ablation)
HELPDESK_QWEN_NO_THINK=1
